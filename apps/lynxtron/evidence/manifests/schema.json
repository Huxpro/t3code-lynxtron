{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3.tools/lynxtron/evidence-manifest.schema.json",
  "title": "T3 Code Lynxtron evidence manifest",
  "type": "object",
  "required": ["version", "id", "label", "defaults", "states"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "defaults": {
      "type": "object",
      "required": [
        "route",
        "theme",
        "viewport",
        "density",
        "snapshotSha256",
        "selectedProject",
        "selectedThread",
        "selectedModel"
      ]
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "requiredClients",
          "state",
          "verdict",
          "evidence"
        ]
      }
    },
    "evidenceStatus": {
      "enum": ["retained", "blocked", "diagnostic", "pending", "not-applicable"]
    },
    "blockedEvidence": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "blockerId",
        "captureTier",
        "buildSha256",
        "assertions"
      ],
      "properties": {
        "status": { "const": "blocked" },
        "blockerId": { "type": "string", "pattern": "^R[0-9]+$" },
        "captureTier": { "const": "native" },
        "path": false
      }
    }
  }
}
