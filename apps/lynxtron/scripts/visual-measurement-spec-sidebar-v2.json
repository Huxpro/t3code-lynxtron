    },
    {
      "id": "sidebarSearch",
      "web": "[data-sidebar-version=\"v2\"] [data-slot=\"command-dialog-trigger\"]",
      "lynx": ".sidebar-v2-search"
    }
  ],
  "typography": [
    {
      "id": "brand",
      "web": ".sidebar-brand-code-label",
      "lynx": ".sidebar-brand-code-label"
    },
    {
      "id": "headline",
      "web": "h1",
      "lynx": ".hero__headline"
    },
    {
      "id": "sidebarSearch",
      "web": "[data-sidebar-version=\"v2\"] [data-slot=\"command-dialog-trigger\"]",
