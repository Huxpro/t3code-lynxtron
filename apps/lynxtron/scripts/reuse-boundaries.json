{
  "schemaVersion": 1,
  "denominator": "eligible-web-production-modules",
  "sourceExtensions": [".css", ".cjs", ".js", ".jsx", ".mjs", ".ts", ".tsx"],
  "exclusions": {
    "pathPrefixes": [
      "node_modules/",
      "apps/lynxtron/src/main/",
      "apps/lynxtron/src/app/generated/",
      "apps/web/src/components/preview/",
      "apps/web/src/components/terminal/",
      "apps/web/src/components/diffs/"
    ],
    "exactPaths": [
      "apps/lynxtron/src/app/components/iconData.ts",
      "apps/lynxtron/src/app/routeTree.gen.ts",
      "apps/web/src/components/ComposerPromptEditor.tsx",
      "apps/web/src/components/ThreadTerminalDrawer.tsx",
      "apps/web/src/routeTree.gen.ts"
    ],
    "pathPatterns": ["\\.(?:test|spec)\\.[cm]?[jt]sx?$", "\\.d\\.ts$"]
  },
  "hardIslands": [
    {
      "id": "terminal",
      "reason": "R6 canvas/xterm runtime island",
      "paths": [
        "apps/web/src/components/terminal/",
        "apps/web/src/components/ThreadTerminalDrawer.tsx"
      ]
    },
    {
      "id": "lexical-editor",
      "reason": "R2 DOM/contentEditable runtime island",
      "paths": ["apps/web/src/components/ComposerPromptEditor.tsx"]
    },
    {
      "id": "embedded-preview",
      "reason": "R7 embedded web-surface runtime island",
      "paths": ["apps/web/src/components/preview/"]
    },
    {
      "id": "full-patch-renderer",
      "reason": "R10 DOM/Worker patch-rendering island",
      "paths": ["apps/web/src/components/diffs/"]
    }
  ],
  "patchedPairs": [
    {
      "id": "generated-theme-css",
      "source": "apps/web/src/index.css",
      "output": "apps/lynxtron/src/app/generated/lynx.css",
      "generator": "apps/lynxtron/scripts/generate-lynx-css.mjs"
    }
  ],
