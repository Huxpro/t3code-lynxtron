{
  "schemaVersion": 1,
  "route": "sidebar-v2-host-populated",
  "stability": {
    "webAbsentText": ["Reconnecting...", "Connecting..."]
  },
  "anchors": [
    {
      "id": "sidebar",
      "web": "[data-sidebar=\"sidebar\"]",
      "lynx": ".sidebar"
    },
    {
      "id": "workspaceHeader",
      "web": "[data-chat-header]",
      "lynx": "[data-chat-header]"
    },
    {
      "id": "composer",
      "web": ".chat-composer-glass-shell",
      "lynx": ".composer-shell"
    },
    {
      "id": "sidebarSearch",
      "web": "[data-sidebar-version=\"v2\"] .sidebar-v2-search",
      "lynx": ".sidebar-v2-search"
    },
    {
      "id": "sidebarFirstRowTitle",
      "web": "[data-sidebar-version=\"v2\"] .sidebar-v2-row-title",
      "lynx": ".sidebar-v2-row-title"
    }
  ],
  "typography": [
    {
      "id": "brand",
      "web": ".sidebar-brand-code-label",
      "lynx": ".sidebar-brand-code-label"
    },
    {
      "id": "sidebarSearch",
      "web": "[data-sidebar-version=\"v2\"] input[aria-label=\"Search threads\"]",
      "lynx": ".sidebar-v2-search-label"
    },
    {
      "id": "sidebarFirstRowTitle",
      "web": "[data-sidebar-version=\"v2\"] .sidebar-v2-row-title",
      "lynx": ".sidebar-v2-row-title"
    }
  ],
  "colors": [
    {
      "id": "appBackground",
      "web": "body",
      "lynx": ".app-root",
      "properties": ["backgroundColor"]
    },
    {
      "id": "sidebarBackground",
      "web": "[data-sidebar=\"sidebar\"]",
      "lynx": ".sidebar"
    },
    {
      "id": "composerBackground",
      "web": ".chat-composer-glass-shell",
      "webPseudo": "::before",
      "lynx": ".composer-surface",
      "properties": ["backgroundColor"]
    },
    {
      "id": "sidebarSearchBackground",
      "web": "[data-sidebar-version=\"v2\"] .sidebar-v2-search",
      "lynx": ".sidebar-v2-search",
      "properties": ["backgroundColor"]
    }
  ]
}
