{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleSuffixes": [".lynx", ""],
    "target": "ES2022",
    "lib": ["ES2023"],
    "strict": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["@lynx-js/types"],
    "paths": {
      "@base-ui/react/merge-props": ["./platform/base-ui/merge-props.ts"],
      "@base-ui/react/separator": ["./platform/base-ui/separator.tsx"],
      "@base-ui/react/use-render": ["./platform/base-ui/use-render.ts"],
      "@tanstack/react-router": ["./platform/tanstack/react-router.tsx"],
      "~/*": ["../../../web/src/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.d.ts",
    "../shared/**/*.ts",
    "../../../web/src/**/*.lynx.ts",
    "../../../web/src/**/*.lynx.tsx"
  ],
  "exclude": ["./routes/**", "./routeTree.gen.ts"]
}
