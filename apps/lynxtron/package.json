{
  "name": "@t3tools/lynxtron",
  "version": "0.0.28",
  "private": true,
  "description": "T3 Code desktop client rendered by Lynx and hosted by Lynxtron.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "pnpm run prepare:cef-runtime && pnpm run build:connector && cross-env TARGET_ENV=desktop NODE_ENV=development concurrently -k --raw \"rspeedy dev\" \"dev-ready-rspeedy && rspack watch\"",
    "build": "pnpm run prepare:cef-runtime && pnpm run generate:css && pnpm run build:icons && pnpm run format:generated && rspeedy build && rspack build && pnpm run build:connector",
    "build:browser-preview": "cross-env T3_LYNXTRON_WEB_PREVIEW=1 rspeedy build && cross-env T3_LYNXTRON_WEB_PREVIEW=1 T3_LYNXTRON_PROBE_ENTRY=./src/app/components-lab-isolated.tsx T3_LYNXTRON_PROBE_OUTPUT=./output/bundle/web-components-lab-isolated rspeedy build && rspack build --config rspack.browser-preview.config.ts",
    "build:workbench": "pnpm run build:browser-preview && pnpm --dir ../web exec vp build",
    "package:dir": "pnpm run build && lynxtron-builder --dir --publish never",
    "capture:workbench": "node scripts/capture-shared-workbench.mjs",
    "seed:workbench": "node scripts/sb2-seed-shared-state.mjs",
    "evidence:verify": "node scripts/verify-evidence-manifest.mjs",
    "evidence:verify:archived": "node scripts/verify-evidence-manifest.mjs --require-archived-evidence",
    "evidence:verify:planning": "node scripts/verify-evidence-manifest.mjs --allow-incomplete",
    "evidence:gallery": "node scripts/generate-comparison-archive.mjs",
    "evidence:process-leaks": "node scripts/check-agent-browser-leaks.mjs",
    "evidence:screenshot-budget": "node scripts/check-screenshot-budget.mjs --limit 100",
    "build:icons": "node scripts/build-icons.mjs",
    "build:connector": "node scripts/build-connector.mjs",
    "capture:web": "node scripts/capture-electron-cdp.mjs",
    "capture:lynx": "node scripts/capture-lynx-devtool.mjs",
    "generate:css": "node scripts/generate-lynx-css.mjs",
    "format:generated": "vp fmt src/app/generated/lynx.css src/app/components/iconData.ts",
    "audit": "node scripts/audit-web-apis.mjs && node scripts/audit-css.mjs",
    "audit:mts": "node scripts/audit-main-thread-script.mjs",
    "launch": "pnpm run prepare:cef-runtime && lynxtron ./dist/desktop",
    "prepare:cef-runtime": "node scripts/cef-frameworks.mjs",
    "report:provenance": "node scripts/provenance-report.mjs",
    "report:reuse": "node scripts/reuse-report.mjs",
    "check:runtime-budget": "node scripts/check-runtime-budget.mjs",
    "report:components-lab": "node scripts/component-lab-inventory.mjs",
    "report:components-lab:check": "node scripts/component-lab-inventory.mjs --check",
    "report:style-coverage": "node scripts/style-coverage-report.mjs",
    "report:gap-atlas": "node scripts/generate-gap-atlas.mjs",
    "report:fidelity-loss": "node scripts/fidelity-loss.mjs",
    "report:fidelity-loss:check": "node scripts/fidelity-loss.mjs --check",
    "smoke:settings": "pnpm run build:connector && node scripts/settings-smoke.mjs",
    "smoke:composer-controls": "pnpm run build:connector && node scripts/composer-controls-smoke.mjs",
    "smoke:shared-environment": "pnpm run build:connector && node scripts/shared-environment-connector-smoke.mjs",
    "smoke:remote-reconnect": "pnpm run build:connector && node scripts/remote-environment-reconnect-smoke.mjs",
    "smoke:shared-environment-native": "pnpm run build:connector && node scripts/shared-environment-native-smoke.mjs",
    "smoke:shared-environment-web-native": "pnpm run build:connector && node scripts/shared-environment-web-native-smoke.mjs",
    "start": "pnpm run build && pnpm run launch",
    "typecheck": "tsc --noEmit -p src/app/tsconfig.json && tsc --noEmit -p src/main/desktop/tsconfig.json",
    "typecheck:browser-preview": "tsc --noEmit -p src/browser-preview/tsconfig.json",
    "test": "vp test run --passWithNoTests",
    "visual:diff": "node scripts/visual-diff.mjs",
    "visual:assert-lifecycle-error": "node scripts/assert-lifecycle-error-baseline.mjs",
    "verify:packaged-readiness": "node scripts/verify-packaged-readiness.mjs",
    "verify:transcript-recycling": "node scripts/verify-long-transcript-recycling.mjs",
    "verify:packaged-cef-webview": "node scripts/verify-packaged-cef-webview.mjs",
    "verify:mts-product": "node scripts/verify-mts-product-controls.mjs",
    "verify:mts-runtime": "node scripts/verify-mts-runtime-contract.mjs",
    "verify:page-config": "node scripts/verify-page-config-capabilities.mjs",
    "verify:plan11-semantics": "node scripts/verify-packaged-readiness.mjs --verify-plan11-semantic-outcomes",
    "visual:metrics": "node scripts/compare-visual-measurements.mjs",
    "visual:prepare": "node scripts/prepare-visual-state.mjs",
    "visual:prepare-sidebar": "node scripts/prepare-sidebar-visual-state.mjs"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@lynx-js/cef-webview": "0.0.28",
    "@lynx-js/lynxtron": "0.0.28",
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@tanstack/react-router": "^1.170.18",
    "core-js": "3.47.0",
    "effect": "catalog:",
    "url-search-params-polyfill": "^8.2.5"
  },
  "devDependencies": {
    "@lynx-js/config-rsbuild-plugin": "0.2.4",
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/lynxtron-builder": "0.0.28",
    "@lynx-js/lynxtron-dev-plugins": "0.0.28",
    "@lynx-js/react": "0.126.2",
    "@lynx-js/react-rsbuild-plugin": "0.20.3",
    "@lynx-js/rspeedy": "0.18.0",
    "@lynx-js/tailwind-preset": "^0.6.0",
    "@lynx-js/type-config": "4.2.0",
    "@lynx-js/types": "4.3.0",
    "@lynx-js/web-core": "0.26.2",
    "@lynx-js/web-elements": "0.12.12",
    "@rsbuild/core": "2.2.9",
    "@rspack/cli": "^1.7.5",
    "@rspack/core": "^1.7.5",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "catalog:",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "enhanced-resolve": "^5.24.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.19",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
